# Environment Configuration for CareerPilot AI
# Copy this file to .env and adjust variables as needed

# Database Configuration
POSTGRES_DB=careerpilot_db
POSTGRES_USER=careerpilot
POSTGRES_PASSWORD=secret_password
POSTGRES_PORT=5433
POSTGRES_HOST=localhost

# Spring Boot Backend
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/careerpilot_db
SPRING_DATASOURCE_USERNAME=careerpilot
SPRING_DATASOURCE_PASSWORD=secret_password

# JWT Security
# Must be at least 256 bits (32+ bytes) for HS256/HS384/HS512
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# File Storage
UPLOAD_DIR=./uploads/resumes
MAX_FILE_SIZE_MB=5

# Gemini AI & Embeddings (Configurable - for subsequent phases)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_EVALUATOR_MODEL=gemini-3.1-pro-preview
GEMINI_EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080/api/v1

